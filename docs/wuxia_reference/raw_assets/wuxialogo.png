    <title>Wuxia Logs – Text-Based Game of Martial Choices</title>
    <meta
      name="description"
      content="Live a martial life through choices. Explore Jianghu, master skills, and fight turn-based battles in this text-based wuxia game."
    />
    <meta name="theme-color" content="#191919" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="canonical" href="https://play.wuxialogs.com" />

    <script>
      (function () {
        var h = window.location.hostname;
        if (h === "playwuxia.pages.dev" || h.endsWith(".playwuxia.pages.dev")) {
          window.location.replace(
            "https://play.wuxialogs.com" +
              window.location.pathname +
              window.location.search +
              window.location.hash
          );
        }

        function handleChunkMismatch(msg) {
          if (
            msg &&
            (msg.indexOf("dynamically imported module") !== -1 ||
              msg.indexOf("Failed to fetch") !== -1 ||
              msg.indexOf("Failed to load module") !== -1 ||
              msg.indexOf("Importing a module") !== -1 ||
              msg.indexOf("Expected a JavaScript-or-Wasm") !== -1)
          ) {
            var last = sessionStorage.getItem("last_chunk_reload");
            var now = Date.now();
            if (!last || now - parseInt(last, 10) > 8000) {
              sessionStorage.setItem("last_chunk_reload", now.toString());
              var url = new URL(window.location.href);
              url.searchParams.set("_v", now.toString());
              window.location.replace(url.toString());
            }
          }
        }

        window.addEventListener("error", function (e) {
          handleChunkMismatch(e && e.message);
        });

        window.addEventListener("unhandledrejection", function (e) {
          var reason = e && e.reason;
          handleChunkMismatch(reason && (reason.message || String(reason)));
        });
      })();
    </script>

