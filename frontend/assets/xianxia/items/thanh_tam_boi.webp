<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" width="100" height="100">
  <defs>
    <radialGradient id="relicGrad" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#34d399"/>
      <stop offset="60%" stop-color="#059669"/>
      <stop offset="100%" stop-color="#064e3b"/>
    </radialGradient>
    <filter id="relicGlow">
      <feGaussianBlur stdDeviation="3" result="blur"/>
      <feComposite in="SourceGraphic" in2="blur" operator="over"/>
    </filter>
  </defs>
  <rect width="100" height="100" rx="20" fill="#0d151c" stroke="#10b981" stroke-width="2"/>
  <circle cx="50" cy="50" r="38" fill="url(#relicGrad)" filter="url(#relicGlow)"/>
  <circle cx="50" cy="50" r="28" fill="none" stroke="#a7f3d0" stroke-width="2" stroke-dasharray="4,2"/>
  <text x="50" y="62" font-size="34" font-family="'Noto Serif TC', serif" font-weight="900" fill="#ffffff" text-anchor="middle" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.8))">佩</text>
</svg>
