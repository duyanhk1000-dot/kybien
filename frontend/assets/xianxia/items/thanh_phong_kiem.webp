<svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#064e3b"/>
      <stop offset="100%" stop-color="#065f46"/>
    </linearGradient>
    <radialGradient id="halo" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#34d399" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#34d399" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="64" height="64" rx="8" fill="url(#bgGrad)" stroke="#34d399" stroke-width="1.5" stroke-opacity="0.4"/>
  <circle cx="32.0" cy="32.0" r="28.8" fill="url(#halo)"/>
  <text x="50%" y="54%" dominant-baseline="central" text-anchor="middle" fill="#34d399" font-family="'Noto Serif TC', serif, 'SimSun'" font-size="28px" font-weight="bold" opacity="0.9">劍</text>
  <text x="50%" y="58" text-anchor="middle" fill="#e2e8f0" font-family="sans-serif" font-size="9" opacity="0.85">Thanh Phong Kiếm</text>
