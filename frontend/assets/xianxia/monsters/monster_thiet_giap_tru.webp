<svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 120 120">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#450a0a"/>
      <stop offset="100%" stop-color="#7f1d1d"/>
    </linearGradient>
    <radialGradient id="halo" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f87171" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#f87171" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="120" height="120" rx="8" fill="url(#bgGrad)" stroke="#f87171" stroke-width="1.5" stroke-opacity="0.4"/>
  <circle cx="60.0" cy="60.0" r="54.0" fill="url(#halo)"/>
  <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" fill="#f87171" font-family="'Noto Serif TC', serif, 'SimSun'" font-size="52px" font-weight="bold" opacity="0.9">豬</text>
  <text x="50%" y="106" text-anchor="middle" fill="#e2e8f0" font-family="sans-serif" font-size="9" opacity="0.85">Thiết Giáp Trư</text>
