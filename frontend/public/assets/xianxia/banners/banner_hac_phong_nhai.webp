<svg xmlns="http://www.w3.org/2000/svg" width="800" height="260" viewBox="0 0 800 260">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <radialGradient id="halo" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#38bdf8" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="800" height="260" rx="8" fill="url(#bgGrad)" stroke="#38bdf8" stroke-width="1.5" stroke-opacity="0.4"/>
  <circle cx="400.0" cy="130.0" r="117.0" fill="url(#halo)"/>
  <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" fill="#38bdf8" font-family="'Noto Serif TC', serif, 'SimSun'" font-size="72px" font-weight="bold" opacity="0.9">崖</text>
  <text x="50%" y="246" text-anchor="middle" fill="#e2e8f0" font-family="sans-serif" font-size="44" opacity="0.85">Hắc Phong Nhai</text>
