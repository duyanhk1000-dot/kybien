generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             Int       @id @default(autoincrement())
  username       String    @unique @db.VarChar(50)
  email          String    @unique @db.VarChar(100)
  password_hash  String    @db.VarChar(255)
  elo            Int       @default(1200)
  exp            BigInt    @default(0)
  level          Int       @default(1)
  matches_played Int       @default(0)
  matches_won    Int       @default(0)
  created_at     DateTime  @default(now())

  matches_as_white Match[] @relation("PlayerWhite")
  matches_as_black Match[] @relation("PlayerBlack")

  // Cờ Thế Relations
  created_puzzles   Puzzle[]             @relation("UserCreatedPuzzles")
  puzzle_progresses UserPuzzleProgress[]
  puzzle_rewards    PuzzleRewardLog[]
  puzzle_defeats    PuzzleDefeatLog[]
  puzzle_sessions   PuzzleSession[]

  @@map("users")
}

model Match {
  id              String   @id @default(uuid()) @db.Uuid
  player_white_id Int?
  player_black_id Int?
  pgn_moves       String   @db.Text
  result          String   @db.VarChar(10) // 'WHITE_WIN', 'BLACK_WIN', 'DRAW'
  is_featured     Boolean  @default(false)
  blogger_post_id String?  @db.VarChar(50)
  created_at      DateTime @default(now())

  player_white User? @relation("PlayerWhite", fields: [player_white_id], references: [id], onDelete: SetNull)
  player_black User? @relation("PlayerBlack", fields: [player_black_id], references: [id], onDelete: SetNull)

  @@map("matches")
}

enum PuzzleTier {
  EASY
  MEDIUM
  HARD
  UGC
}

enum PuzzleStatus {
  DRAFT
  VERIFIED
  PUBLISHED
  HIDDEN
}

enum PuzzlePlayMode {
  TRADITIONAL
  KYBIEN_SPELL
}

enum PuzzleSessionType {
  PRACTICE
  RANKED
}

enum SessionStatus {
  ACTIVE
  WON
  DEFEATED
  EXPIRED
}

model Puzzle {
  id             Int          @id @default(autoincrement())
  tier           PuzzleTier   @default(EASY)
  order_index    Int?
  title          String       @db.VarChar(150)
  fen            String       @db.VarChar(150)
  solution_tree  String       @db.Text // JSON Solution DAG / Move Tree
  description    String?      @db.VarChar(255)
  constraints    String?      @db.Text // JSON Challenge Constraints (max_moves, forbidden_pieces, etc.)
  status         PuzzleStatus @default(PUBLISHED)
  creator_id     Int?
  is_daily       Boolean      @default(false)
  daily_date     DateTime?    @db.Date
  play_count     Int          @default(0)
  defeat_count   Int          @default(0)
  upvote_count   Int          @default(0)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  creator     User?                @relation("UserCreatedPuzzles", fields: [creator_id], references: [id], onDelete: SetNull)
  progresses  UserPuzzleProgress[]
  defeat_logs PuzzleDefeatLog[]
  reward_logs PuzzleRewardLog[]
  sessions    PuzzleSession[]

  @@unique([tier, order_index])
  @@index([status, tier])
  @@index([is_daily, daily_date])
  @@map("puzzles")
}

model UserPuzzleProgress {
  id              Int            @id @default(autoincrement())
  user_id         Int
  puzzle_id       Int
  mode            PuzzlePlayMode @default(TRADITIONAL)
  is_solved       Boolean        @default(false)
  attempts        Int            @default(1)
  best_time_sec   Int?
  spells_used     Int            @default(0)
  first_solved_at DateTime?
  updated_at      DateTime       @updatedAt

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzle_id], references: [id], onDelete: Cascade)

  @@unique([user_id, puzzle_id, mode])
  @@index([user_id, is_solved])
  @@map("user_puzzle_progress")
}

model PuzzleRewardLog {
  id         String         @id @default(uuid()) @db.Uuid
  user_id    Int
  puzzle_id  Int
  mode       PuzzlePlayMode
  reward_key String         @unique @db.VarChar(100) // Khóa chặn cộng trùng: "FIRST_CLEAR:100:3:TRADITIONAL" hoặc "DAILY:100:2026-10-17"
  exp_amount Int
  created_at DateTime       @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzle_id], references: [id], onDelete: Cascade)

  @@index([user_id, mode])
  @@map("puzzle_reward_logs")
}

model PuzzleDefeatLog {
  id           Int      @id @default(autoincrement())
  puzzle_id    Int
  solver_id    Int
  ip_hash      String   @db.VarChar(64) // Băm SHA-256 ẩn danh
  duration_sec Int
  moves_count  Int
  exp_granted  Int      @default(0)
  created_at   DateTime @default(now())

  puzzle Puzzle @relation(fields: [puzzle_id], references: [id], onDelete: Cascade)
  solver User   @relation(fields: [solver_id], references: [id], onDelete: Cascade)

  @@unique([puzzle_id, solver_id])
  @@index([created_at])
  @@map("puzzle_defeat_logs")
}

model PuzzleSession {
  id           String            @id @default(uuid()) @db.Uuid
  user_id      Int?
  puzzle_id    Int
  mode         PuzzlePlayMode    @default(TRADITIONAL)
  session_type PuzzleSessionType @default(RANKED)
  current_fen  String            @db.VarChar(150)
  move_history String            @db.Text // JSON string array các nước đi UCI
  status       SessionStatus     @default(ACTIVE)
  expires_at   DateTime
  created_at   DateTime          @default(now())
  updated_at   DateTime          @updatedAt

  user   User?  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  puzzle Puzzle @relation(fields: [puzzle_id], references: [id], onDelete: Cascade)

  @@index([expires_at])
  @@index([user_id, status])
  @@map("puzzle_sessions")
}
